# Public image defaults shared by Bash, Compose (--env-file) and CI. No secrets.
# shellcheck shell=bash
NODE_VERSION=${NODE_VERSION:-24}
SUBQL_NODE_VERSION=${SUBQL_NODE_VERSION:-v6.4.6}
NODE_IMAGE=${NODE_IMAGE:-docker.io/library/node:${NODE_VERSION}-alpine}
SUBQL_NODE_IMAGE=${SUBQL_NODE_IMAGE:-docker.io/subquerynetwork/subql-node-substrate:${SUBQL_NODE_VERSION}}
SUBQL_PRODUCTION_IMAGE=${SUBQL_PRODUCTION_IMAGE:-docker.io/onfinality/subql-node:${SUBQL_NODE_VERSION}}
